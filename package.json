{
  "name": "velclaw-docs",
  "version": "2.0.0",
  "private": true,
  "description": "Velclaw documentation powered by Docus, Nuxt 4 and Nuxt Content.",
  "scripts": {
    "dev": "nuxt dev",
    "predev": "npm run content:sync",
    "build": "nuxt generate",
    "prebuild": "npm run content:sync",
    "generate": "nuxt generate",
    "content:sync": "node scripts/generate-docus-content.mjs",
    "type-check": "nuxt typecheck",
    "lint": "eslint .",
    "test:content": "node --test scripts/generate-docus-content.test.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "docus": "5.13.0",
    "nuxt": "4.5.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
